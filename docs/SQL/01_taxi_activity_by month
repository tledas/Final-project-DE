SELECT
d. year,
d. month,
SUM (t. trip_count)
As total_trips,
ROUND (SUM (t. total
_fare_usd), 2)
AS total_fare_usd,
ROUND (SUM (t. total_
fare_usd) /NULLIF (SUM(t. trip_count), 0),
ROUND (AVG (t. avg_distance), 2) AS avg_distance
FROM dbo.facttaxidaily t
JOIN dbo.dimdate d
ON t.date_key - d. date_key
GROUP BY
d.year, d.month
ORDER BY
d. year,
d. month;
