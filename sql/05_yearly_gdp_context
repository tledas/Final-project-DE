WITH taxi_yearly AS (
    SELECT
        d.year,
        SUM(t.trip_count) AS total_trips,
        ROUND(SUM(t.total_fare_usd), 2) AS total_fare_usd,
        ROUND(SUM(t.total_fare_usd) / NULLIF(SUM(t.trip_count), 0), 2) AS avg_fare_usd
    FROM dbo.facttaxidaily t
    JOIN dbo.dimdate d
        ON t.date_key = d.date_key
    GROUP BY d.year
),
air_yearly AS (
    SELECT
        d.year,
        a.parameter,
        ROUND(AVG(a.avg_value), 2) AS avg_pollution_value
    FROM dbo.factairqualitydaily a
    JOIN dbo.dimdate d
        ON a.date_key = d.date_key
    GROUP BY d.year, a.parameter
),
air_pivot AS (
    SELECT
        year,
        MAX(CASE WHEN parameter = 'pm25' THEN avg_pollution_value END) AS avg_pm25,
        MAX(CASE WHEN parameter = 'pm10' THEN avg_pollution_value END) AS avg_pm10,
        MAX(CASE WHEN parameter = 'pm1' THEN avg_pollution_value END) AS avg_pm1,
        MAX(CASE WHEN parameter = 'o3' THEN avg_pollution_value END) AS avg_o3
    FROM air_yearly
    GROUP BY year
)
SELECT
    t.year,
    t.total_trips,
    t.total_fare_usd,
    t.avg_fare_usd,
    g.gdp_usd,
    ROUND(t.total_fare_usd / NULLIF(g.gdp_usd, 0) * 100, 6) AS taxi_revenue_pct_of_gdp,
    a.avg_pm25,
    a.avg_pm10,
    a.avg_pm1,
    a.avg_o3
FROM taxi_yearly t
LEFT JOIN dbo.dimgdp g
    ON t.year = g.year
LEFT JOIN air_pivot a
    ON t.year = a.year
ORDER BY t.year;
