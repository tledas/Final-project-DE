SELECT
    z.Borough,
    z.Zone,
    t.zone_id,
    SUM(t.trip_count) AS total_trips,
    ROUND(SUM(t.total_fare_usd), 2) AS total_fare_usd,
    ROUND(SUM(t.total_fare_usd) / NULLIF(SUM(t.trip_count), 0), 2) AS avg_fare_usd,
    ROUND(AVG(t.avg_distance), 2) AS avg_distance
FROM dbo.facttaxidaily t
LEFT JOIN dbo.dimzone z
    ON t.zone_id = z.LocationID
GROUP BY
    z.Borough,
    z.Zone,
    t.zone_id
ORDER BY total_trips DESC;
