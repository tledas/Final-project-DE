WITH taxi_monthly AS (
    SELECT
        d.year,
        d.month,
        SUM(t.trip_count) AS total_trips,
        ROUND(SUM(t.total_fare_usd), 2) AS total_fare_usd,
        ROUND(SUM(t.total_fare_usd) / NULLIF(SUM(t.trip_count), 0), 2) AS avg_fare_usd
    FROM dbo.facttaxidaily t
    JOIN dbo.dimdate d
        ON t.date_key = d.date_key
    GROUP BY
        d.year,
        d.month
),
air_monthly AS (
    SELECT
        d.year,
        d.month,
        a.parameter,
        ROUND(AVG(a.avg_value), 2) AS avg_pollution_value
    FROM dbo.factairqualitydaily a
    JOIN dbo.dimdate d
        ON a.date_key = d.date_key
    GROUP BY
        d.year,
        d.month,
        a.parameter
)
SELECT
    t.year,
    t.month,
    a.parameter,
    t.total_trips,
    t.total_fare_usd,
    t.avg_fare_usd,
    a.avg_pollution_value
FROM taxi_monthly t
JOIN air_monthly a
    ON t.year = a.year
    AND t.month = a.month
ORDER BY
    t.year,
    t.month,
    a.parameter;
