WITH taxi_daily AS (
    SELECT
        date_key,
        SUM(trip_count) AS total_trips,
        ROUND(SUM(total_fare_usd), 2) AS total_fare_usd,
        ROUND(SUM(total_fare_usd) / NULLIF(SUM(trip_count), 0), 2) AS avg_fare_usd
    FROM dbo.facttaxidaily
    GROUP BY date_key
),
air_daily AS (
    SELECT
        date_key,
        parameter,
        AVG(avg_value) AS avg_value
    FROM dbo.factairqualitydaily
    GROUP BY date_key, parameter
),
air_pivot AS (
    SELECT
        date_key,
        AVG(CASE WHEN parameter = 'pm25' THEN avg_value END) AS pm25,
        AVG(CASE WHEN parameter = 'pm10' THEN avg_value END) AS pm10,
        AVG(CASE WHEN parameter = 'pm1' THEN avg_value END) AS pm1,
        AVG(CASE WHEN parameter = 'o3' THEN avg_value END) AS o3
    FROM air_daily
    GROUP BY date_key
)
SELECT
    d.date,
    d.year,
    d.month,
    t.total_trips,
    t.total_fare_usd,
    t.avg_fare_usd,
    ROUND(a.pm25, 2) AS pm25,
    ROUND(a.pm10, 2) AS pm10,
    ROUND(a.pm1, 2) AS pm1,
    ROUND(a.o3, 2) AS o3
FROM taxi_daily t
JOIN air_pivot a
    ON t.date_key = a.date_key
JOIN dbo.dimdate d
    ON t.date_key = d.date_key
ORDER BY d.date;
