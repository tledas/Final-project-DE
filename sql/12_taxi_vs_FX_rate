DROP TABLE IF EXISTS dbo.rpt_taxi_fx_daily 
CREATE TABLE dbo.rpt_taxi_fx_daily AS
WITH taxi_daily AS (
    SELECT
        date_key,
        date,
        SUM(trip_count) AS total_trips,
        SUM(total_fare_usd) AS total_fare_usd,
        SUM(avg_fare_eur * trip_count) AS fixed_fare_eur
    FROM dbo.facttaxidaily
    GROUP BY date_key, date
)
SELECT
    d.date,
    d.year,
    d.month,
    t.total_trips,
    ROUND(t.total_fare_usd, 2) AS total_fare_usd,
    ROUND(t.fixed_fare_eur, 2) AS fixed_fare_eur,
    ROUND(t.total_fare_usd / NULLIF(f.usd_eur_rate, 0), 2) AS theoretical_fare_eur,
    ROUND(t.fixed_fare_eur - (t.total_fare_usd / NULLIF(f.usd_eur_rate, 0)), 2) AS eur_difference,
    f.usd_eur_rate
FROM taxi_daily t
JOIN dbo.dimdate d
    ON t.date_key = d.date_key
LEFT JOIN dbo.dimfx f
    ON t.date = f.date;
