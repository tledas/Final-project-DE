SELECT
    'facttaxidaily' AS table_name,
    COUNT(*) AS rows_count,
    COUNT(DISTINCT date_key) AS distinct_dates,
    MIN(date_key) AS min_date_key,
    MAX(date_key) AS max_date_key
FROM dbo.facttaxidaily

UNION ALL

SELECT
    'factairqualitydaily',
    COUNT(*),
    COUNT(DISTINCT date_key),
    MIN(date_key),
    MAX(date_key)
FROM dbo.factairqualitydaily

UNION ALL

SELECT
    'dimdate',
    COUNT(*),
    COUNT(DISTINCT date_key),
    MIN(date_key),
    MAX(date_key)
FROM dbo.dimdate;
