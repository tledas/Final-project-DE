SELECT
    location_name,
    parameter,
    ROUND(AVG(avg_value), 2) AS avg_pollution_value,
    ROUND(MIN(min_value), 2) AS min_pollution_value,
    ROUND(MAX(max_value), 2) AS max_pollution_value,
    SUM(measurement_count) AS measurement_count
FROM dbo.factairqualitydaily
GROUP BY
    location_name,
    parameter
ORDER BY
    location_name,
    parameter;
